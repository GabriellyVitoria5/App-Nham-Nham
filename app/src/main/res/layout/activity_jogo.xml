<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Jogo">

    <!-- Imagens das peças do jogador 1  -->
    <ImageView
        android:id="@+id/jogador1_peca_pequena"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@mipmap/p1"
        android:contentDescription="@string/desc_img_peca_p1"
        android:layout_marginTop="@dimen/borda_20"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/jogador1_peca_media"
        app:layout_constraintHorizontal_chainStyle="spread"
        />

    <ImageView
        android:id="@+id/jogador1_peca_media"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="@dimen/borda_20"
        android:background="@mipmap/m1"
        android:contentDescription="@string/desc_img_peca_m1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/jogador1_peca_pequena"
        app:layout_constraintEnd_toStartOf="@id/jogador1_peca_grande"
        />

    <ImageView
        android:id="@+id/jogador1_peca_grande"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="@dimen/borda_20"
        android:background="@mipmap/g1"
        android:contentDescription="@string/desc_img_peca_g1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/jogador1_peca_media"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <!--imagem das linhas do jogo da velha -->
    <ImageView
        android:id="@+id/img_grid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/grid"
        android:contentDescription="@string/desc_img_grid"
        android:layout_marginStart="@dimen/borda_20"
        android:layout_marginEnd="@dimen/borda_20"
        app:layout_constraintTop_toTopOf="@id/linhas_jogo"
        app:layout_constraintBottom_toBottomOf="@id/linhas_jogo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <!-- Linhas do jogo -->
    <LinearLayout
        android:id="@+id/linhas_jogo"
        android:layout_width="0dp"
        android:layout_height="360dp"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="@id/img_grid"
        app:layout_constraintStart_toStartOf="@id/img_grid"
        app:layout_constraintTop_toBottomOf="@id/jogador1_peca_pequena" >

        <!-- Linha 1 -->
        <LinearLayout
            android:id="@+id/linha1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- 3 posições da linha 1 -->
            <ImageView
                android:id="@+id/bloco1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="20sp"
                android:contentDescription="@string/desc_img_bloco1" />

            <ImageView
                android:id="@+id/bloco2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="20sp"
                android:contentDescription="@string/desc_img_bloco2" />

            <ImageView
                android:id="@+id/bloco3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="20sp"
                android:contentDescription="@string/desc_img_bloco3" />

        </LinearLayout>

        <!-- Linha 2 -->
        <LinearLayout
            android:id="@+id/linha2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- 3 posições da linha 2 -->
            <ImageView
                android:id="@+id/bloco4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="20sp"
                android:contentDescription="@string/desc_img_bloco4" />

            <ImageView
                android:id="@+id/bloco5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="20sp"
                android:contentDescription="@string/desc_img_bloco5" />

            <ImageView
                android:id="@+id/bloco6"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="20sp"
                android:contentDescription="@string/desc_img_bloco6" />

        </LinearLayout>

        <!-- Linha 3 -->
        <LinearLayout
            android:id="@+id/linha3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- 3 posições da linha 3 -->
            <ImageView
                android:id="@+id/bloco7"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="20sp"
                android:contentDescription="@string/desc_img_bloco7" />

            <ImageView
                android:id="@+id/bloco8"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="20sp"
                android:contentDescription="@string/desc_img_bloco8" />

            <ImageView
                android:id="@+id/bloco9"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="20sp"
                android:contentDescription="@string/desc_img_bloco9" />
        </LinearLayout>

    </LinearLayout>

    <!-- Imagens das peças do jogador 2 -->
    <ImageView
        android:id="@+id/jogador2_peca_pequena"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="@dimen/borda_20"
        android:background="@mipmap/p2"
        android:contentDescription="@string/desc_img_peca_p2"
        app:layout_constraintTop_toBottomOf="@id/linhas_jogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/jogador2_peca_media"
        app:layout_constraintHorizontal_chainStyle="spread"
        />

    <ImageView
        android:id="@+id/jogador2_peca_media"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="@dimen/borda_20"
        android:background="@mipmap/m2"
        android:contentDescription="@string/desc_img_peca_m2"
        app:layout_constraintTop_toBottomOf="@id/linhas_jogo"
        app:layout_constraintStart_toEndOf="@id/jogador2_peca_pequena"
        app:layout_constraintEnd_toStartOf="@id/jogador2_peca_grande"
        />

    <ImageView
        android:id="@+id/jogador2_peca_grande"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="@dimen/borda_20"
        android:background="@mipmap/g2"
        android:contentDescription="@string/desc_img_peca_g2"
        app:layout_constraintTop_toBottomOf="@id/linhas_jogo"
        app:layout_constraintStart_toEndOf="@id/jogador2_peca_media"
        app:layout_constraintEnd_toEndOf="parent"
        />


    <!-- Botão para voltar à tela inicial -->
    <Button
        android:id="@+id/btn_jogo_voltar_inicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/voltar"
        android:textSize="@dimen/font_pequena"
        app:cornerRadius="0dp"
        android:paddingStart="50dp"
        android:paddingEnd="50dp"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        app:layout_constraintTop_toBottomOf="@+id/jogador2_peca_pequena"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_resultado"
        app:layout_constraintHorizontal_chainStyle="spread"
        />

    <!-- Botão de resultado fica oculto até a partida terminar -->
    <Button
        android:id="@+id/btn_resultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/resultado"
        android:textSize="@dimen/font_pequena"
        app:cornerRadius="0dp"
        android:paddingStart="50dp"
        android:paddingEnd="50dp"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        app:layout_constraintTop_toBottomOf="@+id/jogador2_peca_pequena"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_jogo_voltar_inicio"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Contadores de peças do jogador 1 -->
    <TextView
        android:id="@+id/contador_pecas_jogador1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/jogador1_peca_grande"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="Jogador 1: P=3 M=3 G=3" />

    <!-- Contadores de peças do jogador 2 -->
    <TextView
        android:id="@+id/contador_pecas_jogador2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/jogador2_peca_grande"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="Jogador 2: P=3 M=3 G=3" />

</androidx.constraintlayout.widget.ConstraintLayout>