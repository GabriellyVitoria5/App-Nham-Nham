<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Jogo">

    <!-- Imagens das peças do jogador 1  -->
    <ImageView
        android:id="@+id/jogador1_peca_pequena"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@mipmap/ic_launcher"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/jogador1_peca_media"
        app:layout_constraintHorizontal_chainStyle="spread"
        />

    <ImageView
        android:id="@+id/jogador1_peca_media"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="20dp"
        android:background="@mipmap/ic_launcher"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/jogador1_peca_pequena"
        app:layout_constraintEnd_toStartOf="@id/jogador1_peca_grande"
        />

    <ImageView
        android:id="@+id/jogador1_peca_grande"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="20dp"
        android:background="@mipmap/ic_launcher"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/jogador1_peca_media"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <!--imagem das linhas do jogo da velha -->
    <ImageView
        android:id="@+id/img_grid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/grid"
        android:layout_marginStart="@dimen/bordas_laterais"
        android:layout_marginEnd="@dimen/bordas_laterais"
        app:layout_constraintTop_toTopOf="@id/linhas_jogo"
        app:layout_constraintBottom_toBottomOf="@id/linhas_jogo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <!-- Jogo -->
    <LinearLayout
        android:id="@+id/linhas_jogo"
        android:layout_width="0dp"
        android:layout_height="360dp"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="@id/img_grid"
        app:layout_constraintStart_toStartOf="@id/img_grid"
        app:layout_constraintTop_toBottomOf="@id/jogador1_peca_pequena" >

        <!-- Linha -->
        <LinearLayout
            android:id="@+id/linha1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!--images of the grid boxes-->
            <ImageView
                android:id="@+id/bloco1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="20sp" />

            <ImageView
                android:id="@+id/bloco2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/bloco3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="20sp"
                />

        </LinearLayout>

        <!-- Linha 2 -->
        <LinearLayout
            android:id="@+id/linha2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/bloco4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="20sp" />

            <ImageView
                android:id="@+id/bloco5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="20sp" />

            <ImageView
                android:id="@+id/bloco6"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="20sp" />

        </LinearLayout>

        <!-- Linha 3 -->
        <LinearLayout
            android:id="@+id/linha3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/bloco7"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="20sp" />

            <ImageView
                android:id="@+id/bloco8"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="20sp" />

            <ImageView
                android:id="@+id/bloco9"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="20sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Imagens das peças do jogador 2 -->
    <ImageView
        android:id="@+id/jogador2_peca_pequena"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="10dp"
        android:background="@mipmap/ic_launcher"
        app:layout_constraintTop_toBottomOf="@id/linhas_jogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/jogador2_peca_media"
        app:layout_constraintHorizontal_chainStyle="spread"
        />

    <ImageView
        android:id="@+id/jogador2_peca_media"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="10dp"
        android:background="@mipmap/ic_launcher"
        app:layout_constraintTop_toBottomOf="@id/linhas_jogo"
        app:layout_constraintStart_toEndOf="@id/jogador2_peca_pequena"
        app:layout_constraintEnd_toStartOf="@id/jogador2_peca_grande"
        />

    <ImageView
        android:id="@+id/jogador2_peca_grande"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="10dp"
        android:background="@mipmap/ic_launcher"
        app:layout_constraintTop_toBottomOf="@id/linhas_jogo"
        app:layout_constraintStart_toEndOf="@id/jogador2_peca_media"
        app:layout_constraintEnd_toEndOf="parent"
        />


    <Button
        android:id="@+id/btn_jogo_voltar_inicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/voltar"
        app:cornerRadius="0dp"
        android:paddingStart="50dp"
        android:paddingEnd="50dp"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        app:layout_constraintTop_toBottomOf="@+id/jogador2_peca_pequena"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_resultado"
        app:layout_constraintHorizontal_chainStyle="spread"
        />

    <Button
        android:id="@+id/btn_resultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/resultado"
        app:cornerRadius="0dp"
        android:paddingStart="50dp"
        android:paddingEnd="50dp"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        app:layout_constraintTop_toBottomOf="@+id/jogador2_peca_pequena"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_jogo_voltar_inicio"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>