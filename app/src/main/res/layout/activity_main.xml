<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    tools:context=".MainActivity">

    <!-- Ondas no fundo da tela -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="470dp"
        android:background="@drawable/wavetop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@drawable/wavebottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Título -->
    <TextView
        android:id="@+id/txt_titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo"
        android:textSize="@dimen/fonte_64"
        android:textStyle="bold"
        android:textColor="@color/light_gray"
        android:layout_marginTop="100dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <!-- Botões de iniciar partida e de regras -->
    <Button
        android:id="@+id/btn_partida"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/partida"
        android:textSize="@dimen/fonte_30"
        android:textStyle="bold"
        android:textColor="@color/purple"
        app:cornerRadius="0dp"
        android:paddingStart="50dp"
        android:paddingEnd="50dp"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:layout_marginTop="200dp"
        android:backgroundTint="@color/light_gray"
        app:strokeColor="@color/purple"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@+id/txt_titulo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btn_regras"
        />

    <Button
        android:id="@+id/btn_regras"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/regras_do_jogo"
        android:textSize="@dimen/fonte_30"
        android:textStyle="bold"
        android:textColor="@color/purple"
        app:cornerRadius="0dp"
        android:paddingStart="50dp"
        android:paddingEnd="50dp"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:layout_marginBottom="50dp"
        android:backgroundTint="@color/light_gray"
        app:strokeColor="@color/purple"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_partida"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />


</androidx.constraintlayout.widget.ConstraintLayout>